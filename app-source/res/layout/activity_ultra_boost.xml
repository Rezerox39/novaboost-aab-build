<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="#ff000000" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- TOP BAR -->
    <LinearLayout android:id="@id/actionBarContainer" android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="16dp" android:paddingBottom="8dp" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <ImageView android:id="@id/backBtn" android:padding="8dp" android:layout_width="32dp" android:layout_height="32dp" android:layout_marginRight="12dp" android:layout_marginEnd="12dp" app:srcCompat="@drawable/ic_keyboard_backspace" android:tint="#ff00e676" />
        <TextView android:textSize="14sp" android:textColor="#ff00e676" android:id="@id/actionBarTitle" android:fontFamily="monospace" android:letterSpacing="0.2" android:textStyle="bold" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ultra_mode" />
    </LinearLayout>

    <!-- CONTENT -->
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp">

        <!-- System Status Banner -->
        <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_cyber_status" android:padding="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="20dp" android:gravity="center">
            <TextView android:textSize="10sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.15" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌞ U L T R A   B O O S T ⌟" />
        </LinearLayout>

        <!-- Feature 1: Ultra Boost -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_card" android:padding="20dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:textSize="10sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌞ F E A T U R E   0 1 ⌟" android:layout_marginBottom="8dp" />
            <TextView android:textSize="13sp" android:textColor="#ccffffff" android:fontFamily="monospace" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/ultra_mode_help" android:layout_marginBottom="16dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textSize="13sp" android:textColor="#99ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/active_ultraboost" android:layout_weight="1" android:textAllCaps="true" />
                <!-- Custom toggle area using ImageViews -->
                <LinearLayout android:orientation="horizontal" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center">
                    <ImageView android:id="@id/switchImg" android:paddingLeft="4dp" android:paddingRight="4dp" android:layout_width="52dp" android:layout_height="28dp" android:src="@drawable/img_switch_off" android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Feature 2: Enhanced Experience -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_card" android:padding="20dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <TextView android:textSize="10sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.15" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌞ F E A T U R E   0 2 ⌟" android:layout_marginBottom="8dp" />
            <TextView android:textSize="13sp" android:textColor="#ccffffff" android:fontFamily="monospace" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/enhanced_experience_when_playing_games" android:layout_marginBottom="16dp" />
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textSize="13sp" android:textColor="#99ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_width="0dp" android:layout_height="wrap_content" android:text="@string/active_ultraboost" android:layout_weight="1" android:textAllCaps="true" />
                <LinearLayout android:orientation="horizontal" android:layout_width="60dp" android:layout_height="30dp" android:gravity="center">
                    <ImageView android:id="@id/switchEnhancedExperienced" android:paddingLeft="4dp" android:paddingRight="4dp" android:layout_width="52dp" android:layout_height="28dp" android:src="@drawable/img_switch_off" android:scaleType="fitCenter" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Hidden content for alignment -->
        <View android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" />
    </LinearLayout>

    <!-- Loading Overlay -->
    <RelativeLayout android:layout_gravity="center" android:orientation="vertical" android:id="@id/loadingContainer" android:background="@drawable/bg_cyber_status" android:padding="24dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
        <ProgressBar android:id="@id/boostingLoading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:indeterminateTint="#ff00e676" />
        <FrameLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_below="@id/boostingLoading" android:layout_centerHorizontal="true">
            <TextView android:textSize="14sp" android:textColor="#ff00e676" android:fontFamily="monospace" android:letterSpacing="0.08" android:padding="12dp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/boosting_android_system" />
        </FrameLayout>
    </RelativeLayout>

    <!-- Version -->
    <TextView android:textSize="9sp" android:textColor="#33ffffff" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:paddingBottom="12dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="v1.0 // U L T R A   B O O S T" />
</LinearLayout>
