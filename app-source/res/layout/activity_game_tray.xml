<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/bg_main" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- TOP APP BAR -->
    <RelativeLayout android:id="@id/titleContainer" android:background="#00000000" android:paddingLeft="20dp" android:paddingRight="16dp" android:paddingTop="18dp" android:paddingBottom="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:layout_alignParentStart="true">
            <TextView android:textSize="20sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🚀" android:layout_marginRight="8dp" android:layout_marginEnd="8dp" />
            <TextView android:textSize="15sp" android:textColor="@color/accent_neon" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N O V A B O O S T" android:layout_marginTop="2dp" />
        </LinearLayout>
        <com.hanks.htextview.rainbow.RainbowTextView android:textSize="10sp" android:textStyle="bold" android:id="@id/vipBtn" android:background="@drawable/bg_cyber_status" android:paddingLeft="10dp" android:paddingTop="3dp" android:paddingRight="10dp" android:paddingBottom="3dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vip_member" android:layout_centerInParent="true" android:fontFamily="monospace" android:letterSpacing="0.1" app:colorSpace="150dp" app:colorSpeed="10dp" />
        <TextView android:textSize="20sp" android:textColor="#ffffffff" android:id="@id/boosterTitleStep1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text="@string/game_list_title" android:layout_centerInParent="true" />
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentRight="true" android:layout_alignParentEnd="true" android:layout_centerVertical="true">
            <TextView android:textSize="18sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="✦" android:layout_marginRight="12dp" android:layout_marginEnd="12dp" />
            <com.airbnb.lottie.LottieAnimationView android:id="@id/settingBtn" android:layout_width="38dp" android:layout_height="38dp" android:padding="4dp" app:lottie_autoPlay="true" app:lottie_fileName="setting.json" app:lottie_loop="true" />
        </LinearLayout>
    </RelativeLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp">

        <!-- SYSTEM MONITOR CARD -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_card" android:padding="18dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                <TextView android:textSize="10sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:letterSpacing="0.25" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="S Y S T E M   M O N I T O R" android:textAllCaps="true" />
                <TextView android:textSize="8sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="● LIVE" />
            </LinearLayout>

            <LinearLayout android:gravity="center" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <!-- CPU readout -->
                <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:textSize="9sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="C P U" android:layout_marginBottom="6dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt;&lt;&lt;&lt;&lt;&lt;&lt;" />
                    <TextView android:textSize="9sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="BUSY" android:layout_marginTop="4dp" />
                </LinearLayout>

                <!-- Storage / RAM dial (real StatFs value set by smali) -->
                <com.github.lzyzsd.circleprogress.ArcProgress android:id="@id/storageProgress" android:layout_width="104dp" android:layout_height="104dp" app:arc_bottom_text="STORAGE" app:arc_bottom_text_size="10sp" app:arc_finished_color="@color/accent_neon" app:arc_text_color="@color/text_white" app:arc_text_size="20sp" app:arc_unfinished_color="@color/accent_neon_faint" />

                <!-- GPU readout -->
                <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1">
                    <TextView android:textSize="9sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="G P U" android:layout_marginBottom="6dp" />
                    <TextView android:textSize="13sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&gt;&gt;&gt;&gt;&gt;&gt;&gt;" />
                    <TextView android:textSize="9sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE" android:layout_marginTop="4dp" />
                </LinearLayout>
            </LinearLayout>

            <View android:background="@color/stroke_neon" android:layout_width="fill_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" />

            <!-- Footer: storage + wifi + real ping -->
            <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content">
                <TextView android:textSize="10sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="INTERNAL STORAGE • WI-FI" />
                <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_cyber_status" android:paddingLeft="10dp" android:paddingTop="5dp" android:paddingRight="10dp" android:paddingBottom="5dp" android:layout_width="wrap_content" android:layout_height="wrap_content">
                    <TextView android:textSize="12sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📶" android:layout_marginRight="6dp" android:layout_marginEnd="6dp" />
                    <TextView android:textSize="11sp" android:textColor="@color/text_white" android:textStyle="bold" android:fontFamily="monospace" android:id="@id/pingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ping" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- PRIMARY ACTION: BOOST NOW -->
        <Button android:textColor="#ff08160A" android:textStyle="bold" android:textSize="15sp" android:fontFamily="monospace" android:letterSpacing="0.12" android:id="@id/fourXGameModeBtn" android:background="@drawable/bg_cyber_button_glow" android:layout_width="fill_parent" android:layout_height="56dp" android:layout_marginBottom="16dp" android:text="⚡   B O O S T   N O W" android:textAllCaps="false" />

        <!-- FEATURE GRID -->
        <TextView android:textSize="10sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.25" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T O O L S" android:layout_marginBottom="12dp" />

        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp">
            <!-- ULTRA BOOST large card -->
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/ultraBoostBtn" android:background="@drawable/bg_cyber_hero" android:padding="18dp" android:layout_width="0dp" android:layout_height="116dp" android:layout_weight="1" android:layout_marginRight="6dp" android:layout_marginEnd="6dp">
                <TextView android:textSize="24sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:layout_marginBottom="8dp" />
                <TextView android:textSize="11sp" android:textColor="@color/accent_neon" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.12" android:gravity="center" android:id="@id/ultraBoostText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ultra_mode" android:textAllCaps="true" />
                <TextView android:textSize="8sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TAP TO RUN →" android:layout_marginTop="6dp" />
            </LinearLayout>
            <!-- GFX TOOLS card -->
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool" android:padding="16dp" android:layout_width="0dp" android:layout_height="116dp" android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginStart="6dp">
                <TextView android:textSize="22sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎮" android:layout_marginBottom="8dp" />
                <TextView android:textSize="10sp" android:textColor="@color/text_white" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gfx_tool" android:textAllCaps="true" />
                <TextView android:textSize="8sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TAP TO RUN →" android:layout_marginTop="6dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <!-- NICK NAME card -->
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool" android:padding="16dp" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginRight="6dp" android:layout_marginEnd="6dp">
                <TextView android:textSize="20sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌨" android:layout_marginBottom="6dp" />
                <TextView android:textSize="10sp" android:textColor="@color/text_white" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="NICK NAME" android:textAllCaps="true" />
            </LinearLayout>
            <!-- COMING SOON card -->
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool_placeholder" android:padding="16dp" android:layout_width="0dp" android:layout_height="96dp" android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginStart="6dp">
                <TextView android:textSize="20sp" android:textColor="@color/text_muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMING" android:textAllCaps="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- HIDDEN TEXTS (required by smali) -->
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="14sp" android:textColor="@color/accent_neon" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/four_x_mode_desc" />
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="14sp" android:textStyle="italic" android:textColor="@color/text_muted" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/warning_previous_version_boost" />
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textColor="@color/accent_neon" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ultra_mode_help" />
    </LinearLayout>

    <!-- HIDDEN STUBS (required by smali) -->
    <RelativeLayout android:id="@id/vipContainer" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <FrameLayout android:id="@id/freeTrialText" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />

    <!-- BOTTOM NAVIGATION PILL -->
    <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_cyber_nav" android:padding="6dp" android:layout_width="fill_parent" android:layout_height="64dp" android:layout_marginLeft="16dp" android:layout_marginRight="16dp" android:layout_marginBottom="16dp">

        <!-- Dashboard (active) -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_pill_active" android:padding="6dp" android:layout_width="0dp" android:layout_height="fill_parent" android:layout_weight="1" android:layout_marginRight="3dp" android:layout_marginEnd="3dp">
            <TextView android:textSize="18sp" android:textColor="#ff08160A" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="▦" />
            <TextView android:textSize="8sp" android:textColor="#ff08160A" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DASHBOARD" android:textAllCaps="true" android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Tools -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/gfxToolBtn" android:padding="6dp" android:layout_width="0dp" android:layout_height="fill_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp">
            <TextView android:textSize="18sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" />
            <TextView android:textSize="8sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TOOLS" android:textAllCaps="true" android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Games -->
        <Button android:textSize="8sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.08" android:id="@id/scanBtn" android:background="#00000000" android:paddingTop="6dp" android:paddingBottom="6dp" android:layout_width="0dp" android:layout_height="fill_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginRight="3dp" android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:text="🎮 GAMES" android:textAllCaps="false" />

        <!-- Setting -->
        <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/settingBtn" android:padding="6dp" android:layout_width="0dp" android:layout_height="fill_parent" android:layout_weight="1" android:layout_marginLeft="3dp" android:layout_marginStart="3dp">
            <TextView android:textSize="18sp" android:textColor="@color/accent_neon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙" />
            <TextView android:textSize="8sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.08" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SETTING" android:textAllCaps="true" android:layout_marginTop="2dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- VERSION TAG -->
    <TextView android:textSize="9sp" android:textColor="@color/text_tertiary" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:paddingBottom="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="v2.2 // N O V A B O O S T" />

</LinearLayout>
