<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="#ff000000" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- TOP APP BAR -->
    <RelativeLayout android:id="@id/titleContainer" android:background="#00000000" android:paddingLeft="20dp" android:paddingRight="16dp" android:paddingTop="16dp" android:paddingBottom="8dp" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentLeft="true" android:layout_alignParentStart="true">
            <TextView android:textSize="18sp" android:textColor="#ff00e676" android:textStyle="bold" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text=">_ " />
            <TextView android:textSize="14sp" android:textColor="#ff00e676" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="N O V A B O O S T" android:layout_marginTop="2dp" />
        </LinearLayout>
        <com.hanks.htextview.rainbow.RainbowTextView android:textSize="10sp" android:textStyle="bold" android:id="@id/vipBtn" android:background="@drawable/bg_cyber_status" android:paddingLeft="10dp" android:paddingTop="3dp" android:paddingRight="10dp" android:paddingBottom="3dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/vip_member" android:layout_centerInParent="true" android:fontFamily="monospace" android:letterSpacing="0.1" app:colorSpace="150dp" app:colorSpeed="10dp" />
        <TextView android:textSize="20sp" android:textColor="#ffffffff" android:id="@id/boosterTitleStep1" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text="@string/game_list_title" android:layout_centerInParent="true" />
        <com.airbnb.lottie.LottieAnimationView android:id="@id/settingBtn" android:layout_width="40dp" android:layout_height="40dp" android:layout_alignParentRight="true" android:layout_alignParentEnd="true" android:layout_centerVertical="true" app:lottie_autoPlay="true" app:lottie_fileName="setting.json" app:lottie_loop="true" />
    </RelativeLayout>

    <!-- MAIN CONTENT -->
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp">

        <!-- SYSTEM STATUS BANNER -->
        <LinearLayout android:orientation="horizontal" android:background="@drawable/bg_cyber_status" android:padding="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center">
            <TextView android:textSize="11sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.15" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌞ SYSTEM ONLINE ⌟" />
        </LinearLayout>

        <!-- HERO: 4X GAME SPACE -->
        <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_hero" android:padding="20dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:gravity="center">
            <TextView android:textSize="10sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌞ ACTIVATE ⌟" android:layout_marginBottom="12dp" />
            <Button android:textColor="#ff000000" android:textStyle="bold" android:textSize="16sp" android:fontFamily="monospace" android:letterSpacing="0.08" android:id="@id/fourXGameModeBtn" android:background="@drawable/bg_cyber_button_glow" android:paddingTop="16dp" android:paddingBottom="16dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/four_x_mode_title" android:textAllCaps="true" />
            <TextView android:textSize="10sp" android:textColor="#4d00e676" android:fontFamily="monospace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⌝ ⌞ N E O N   S P A C E ⌟ ⌝" android:layout_marginTop="10dp" />
        </LinearLayout>

        <!-- STATUS WIDGETS ROW -->
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_card" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="6dp">
                <TextView android:textSize="9sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S T O R A G E" android:layout_marginBottom="8dp" />
                <com.github.lzyzsd.circleprogress.ArcProgress android:id="@id/storageProgress" android:layout_width="90dp" android:layout_height="90dp" app:arc_bottom_text="STORAGE" app:arc_bottom_text_size="10sp" app:arc_finished_color="#ff00e676" app:arc_text_color="#ffffffff" app:arc_text_size="18sp" app:arc_unfinished_color="#1a00e676" />
            </LinearLayout>
            <LinearLayout android:orientation="vertical" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp">
                <LinearLayout android:orientation="vertical" android:background="@drawable/bg_cyber_card" android:padding="16dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="6dp">
                    <TextView android:textSize="9sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="P I N G" android:layout_marginBottom="4dp" />
                    <TextView android:textSize="18sp" android:textColor="#ffffffff" android:textStyle="bold" android:fontFamily="monospace" android:id="@id/pingText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ping" />
                </LinearLayout>
                <Button android:textSize="11sp" android:textColor="#ff00e676" android:fontFamily="monospace" android:letterSpacing="0.05" android:id="@id/scanBtn" android:background="@drawable/bg_cyber_card" android:paddingTop="12dp" android:paddingBottom="12dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/scan" android:textAllCaps="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- HIDDEN LINEAR LAYOUT 2 (required by smali) -->
        <LinearLayout android:id="@id/linearLayout2" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="wrap_content" android:visibility="gone" />

        <!-- TOOLS SECTION -->
        <TextView android:textSize="10sp" android:textColor="#6600e676" android:fontFamily="monospace" android:letterSpacing="0.25" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T O O L S" android:layout_marginBottom="12dp" />

        <!-- TOOLS GRID -->
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/ultraBoostBtn" android:background="@drawable/bg_cyber_tool" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="6dp">
                <TextView android:textSize="18sp" android:textColor="#ff00e676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚡" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="#99ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:id="@id/ultraBoostText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ultra_mode" android:textAllCaps="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:id="@id/gfxToolBtn" android:background="@drawable/bg_cyber_tool" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginRight="6dp">
                <TextView android:textSize="18sp" android:textColor="#ff00e676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🎮" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="#99ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/gfx_tool" android:textAllCaps="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool_placeholder" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp">
                <TextView android:textSize="18sp" android:textColor="#3300e676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="#33ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMING" android:textAllCaps="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- SECOND ROW PLACEHOLDERS -->
        <LinearLayout android:orientation="horizontal" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp">
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool_placeholder" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginRight="6dp">
                <TextView android:textSize="18sp" android:textColor="#3300e676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="#33ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMING" android:textAllCaps="true" />
            </LinearLayout>
            <LinearLayout android:gravity="center" android:orientation="vertical" android:background="@drawable/bg_cyber_tool_placeholder" android:padding="16dp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginLeft="6dp" android:layout_marginRight="6dp">
                <TextView android:textSize="18sp" android:textColor="#3300e676" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="+" android:layout_marginBottom="6dp" />
                <TextView android:textSize="9sp" android:textColor="#33ffffff" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="COMING" android:textAllCaps="true" />
            </LinearLayout>
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:layout_marginLeft="6dp" />
        </LinearLayout>

        <!-- HIDDEN TEXTS (required by smali) -->
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="14sp" android:textColor="#ff00e676" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/four_x_mode_desc" />
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="14sp" android:textStyle="italic" android:textColor="#66ffffff" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="@string/warning_previous_version_boost" />
        <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textColor="#ff00e676" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/ultra_mode_help" />
    </LinearLayout>

    <!-- HIDDEN STUBS (required by smali) -->
    <RelativeLayout android:id="@id/vipContainer" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />
    <FrameLayout android:id="@id/freeTrialText" android:visibility="gone" android:layout_width="0dp" android:layout_height="0dp" />

    <!-- VERSION TAG -->
    <TextView android:textSize="9sp" android:textColor="#33ffffff" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:paddingBottom="12dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="v1.0 // N O V A B O O S T" />

</LinearLayout>
