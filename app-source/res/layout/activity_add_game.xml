<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/bg_main" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <!-- TITLE BAR -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="16dp" android:paddingBottom="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <ImageView android:id="@id/backBtn" android:padding="8dp" android:layout_width="34dp" android:layout_height="34dp" android:layout_marginRight="12dp" android:layout_marginEnd="12dp" app:srcCompat="@drawable/ic_keyboard_backspace" android:tint="@color/accent_neon" />
        <TextView android:textSize="15sp" android:textColor="@color/accent_neon" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.25" android:id="@id/boosterTitleStep1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="GAME LIBRARY" />
    </LinearLayout>
    <View android:background="@color/stroke_neon" android:layout_width="fill_parent" android:layout_height="1dp" />

    <!-- SEARCH + ADD -->
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:layout_width="fill_parent" android:layout_height="wrap_content">
        <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:background="@drawable/bg_cyber_status" android:paddingLeft="12dp" android:paddingRight="12dp" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:layout_marginRight="10dp" android:layout_marginEnd="10dp">
            <TextView android:textSize="15sp" android:textColor="@color/text_muted" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔍" android:layout_marginRight="8dp" android:layout_marginEnd="8dp" />
            <EditText android:textSize="13sp" android:textColor="@color/text_white" android:textColorHint="@color/text_muted" android:fontFamily="monospace" android:hint="SEARCH GAMES..." android:background="#00000000" android:inputType="text" android:singleLine="true" android:layout_width="0dp" android:layout_height="fill_parent" android:layout_weight="1" />
        </LinearLayout>
        <TextView android:textSize="10sp" android:textColor="#ff08160A" android:textStyle="bold" android:fontFamily="monospace" android:letterSpacing="0.08" android:gravity="center" android:background="@drawable/bg_pill_active" android:paddingLeft="14dp" android:paddingRight="14dp" android:layout_width="wrap_content" android:layout_height="44dp" android:text="+ ADD NEW GAME" />
    </LinearLayout>

    <!-- GAME LIST -->
    <LinearLayout android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="14dp" android:paddingBottom="14dp">
        <ListView android:id="@android:id/list" android:background="@android:color/transparent" android:divider="@color/stroke_neon" android:dividerHeight="1dp" android:scrollbars="vertical" android:layout_width="fill_parent" android:layout_height="fill_parent" />
        <TextView android:textSize="13sp" android:textColor="@color/text_muted" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:id="@android:id/empty" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent" android:layout_centerInParent="true" android:text="NO GAMES FOUND" />
    </LinearLayout>

    <!-- VERSION -->
    <TextView android:textSize="9sp" android:textColor="@color/text_tertiary" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:paddingBottom="10dp" android:layout_width="fill_parent" android:layout_height="wrap_content" android:text="v2.2 // G A M E   L I B R A R Y" />
</LinearLayout>
