<?xml version="1.0" encoding="utf-8"?>
<LinearLayout android:orientation="vertical" android:background="@color/bg_main" android:layout_width="fill_parent" android:layout_height="fill_parent"
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <RelativeLayout android:id="@id/normalSplash" android:background="@color/bg_main" android:paddingLeft="32dp" android:paddingTop="16dp" android:paddingRight="32dp" android:paddingBottom="16dp" android:visibility="gone" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <ImageView android:layout_gravity="center" android:id="@id/appIcon" android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/splash_screen_logo" />
            <TextView android:textSize="12sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:letterSpacing="0.3" android:gravity="center" android:id="@id/shortDesText" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/app_short_description" />
        </LinearLayout>
        <LinearLayout android:gravity="center" android:orientation="horizontal" android:id="@id/container" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentBottom="true" android:layout_centerHorizontal="true">
            <com.wang.avi.AVLoadingIndicatorView android:layout_gravity="center" android:id="@id/loading" android:visibility="visible" android:layout_width="24dp" android:layout_height="24dp" app:indicatorColor="@color/accent_neon" app:indicatorName="BallPulseIndicator" style="@style/AVLoadingIndicatorView" />
            <TextView android:textAppearance="@style/TextAppearance.AppCompat.Body1" android:textSize="14sp" android:textColor="@color/accent_neon" android:fontFamily="monospace" android:letterSpacing="0.1" android:ellipsize="end" android:gravity="center" android:layout_gravity="center_vertical" android:id="@id/appName" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="10dp" android:text="@string/app_name" android:layout_marginStart="10dp" />
        </LinearLayout>
    </RelativeLayout>
    <LinearLayout android:orientation="vertical" android:id="@id/acceptPrivacyPolicySplash" android:background="@color/bg_main" android:paddingLeft="32dp" android:paddingTop="16dp" android:paddingRight="32dp" android:paddingBottom="16dp" android:visibility="visible" android:layout_width="fill_parent" android:layout_height="fill_parent">
        <LinearLayout android:gravity="center" android:orientation="vertical" android:layout_width="fill_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_alignParentTop="true" android:layout_centerHorizontal="true">
            <ImageView android:layout_gravity="center" android:layout_width="120dp" android:layout_height="120dp" android:src="@drawable/splash_screen_logo" />
            <TextView android:textSize="24sp" android:textColor="#ffffffff" android:fontFamily="monospace" android:letterSpacing="0.15" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="N O V A B O O S T" android:textStyle="bold" />
            <TextView android:textSize="11sp" android:textColor="@color/accent_neon_soft" android:fontFamily="monospace" android:letterSpacing="0.1" android:gravity="center" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/app_short_description" />
        </LinearLayout>
        <Button android:textStyle="bold" android:textColor="#ff000000" android:fontFamily="monospace" android:letterSpacing="0.1" android:id="@id/startAppBtn" android:background="@drawable/bg_cyber_button_glow" android:layout_width="fill_parent" android:layout_height="52dp" android:layout_marginBottom="16dp" android:text="@string/start" android:textSize="14sp" />
        <LinearLayout android:layout_gravity="bottom" android:orientation="horizontal" android:id="@id/termAndPrivacyContainer" android:layout_width="fill_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" android:layout_alignParentBottom="true">
            <androidx.appcompat.widget.AppCompatCheckBox android:id="@id/checkBoxPrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" app:buttonTint="@color/neon_green" />
            <TextView android:textSize="12sp" android:textColor="@color/text_tertiary" android:fontFamily="monospace" android:layout_gravity="center" android:id="@id/textViewAgreePrivacy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/agree_to_term_and_privacy" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
