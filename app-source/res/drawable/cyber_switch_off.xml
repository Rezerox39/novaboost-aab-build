<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#4dffffff" />
            <corners android:radius="14dp" />
            <size android:width="50dp" android:height="26dp" />
        </shape>
    </item>
    <!-- Thumb -->
    <item android:left="2dp" android:top="2dp" android:right="26dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#66ffffff" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
