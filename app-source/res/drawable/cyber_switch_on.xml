<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1a00e676" />
            <stroke android:width="2dp" android:color="#ff00e676" />
            <corners android:radius="14dp" />
            <size android:width="50dp" android:height="26dp" />
        </shape>
    </item>
    <!-- Thumb with glow -->
    <item android:right="2dp" android:top="2dp" android:left="26dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="#ff00e676" />
            <size android:width="22dp" android:height="22dp" />
        </shape>
    </item>
</layer-list>
